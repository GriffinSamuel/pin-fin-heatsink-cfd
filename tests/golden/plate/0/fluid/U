FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0/fluid";
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (4.0 0 0);

boundaryField
{

    ".*"            { type noSlip; }
    heatsink        { type slip; }
    inlet           { type fixedValue; value uniform (4.0 0 0); }
    outlet          { type pressureInletOutletVelocity; value uniform (0 0 0); }
    #includeEtc "caseDicts/setConstraintTypes"
}
